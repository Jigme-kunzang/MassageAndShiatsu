---
import prestations from '../../../public/prestations.json'
import Header from "../../components/Header.astro"
import Footer from "../../components/Footer.astro"
import '../../styles/globals.css'
import '../../styles/massages.css'
---
<html lang="fr">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width" />
    <title>Massages</title>
  </head>
  <body>
    <Header/>

    <h1>Nos massages</h1>

    <section>
      <div class="massages-list">
        <ul>
          {prestations
            .filter((prestation) => prestation.nom.includes("Massage"))
            .filter((prestation, index, tab) =>
              index === tab.findIndex((p) => p.nom === prestation.nom)
            )
            .map((prestation) => (
              <li><a href={`#${prestation.id}`}><h2>{prestation.nom}</h2></a></li>
            ))}
        </ul>
      </div>
    
      <div class="recup-muscu" id="meridiens">
        <div class="txt">
          <h2>Massage Récupération musculaire des 12 méridiens</h2>
          <p>
            Issu de la médecine traditionnelle japonaise, ce massage suit les
            12 méridiens tendino-musculaires, ces lignes dans lesquelles circule
            l'énergie du corps. Par des étirements longitudinaux et des pressions
            ciblées, il agit sur le système nerveux autonome, apaise le corps et
            l'esprit et relance la libre circulation de l'énergie.
          </p>
          <p>
            Idéal après un entraînement sportif, il relâche les tensions, mobilise
            les articulations et soutient l'immunité. La séance s'articule autour
            de quatre intentions : relâcher le système nerveux autonome, dénouer
            les tensions, étirer et mobiliser.
          </p>
        </div>
        <img src="/pictures/meridiens.jpg" alt="Massage Récupération musculaire des 12 méridiens">
      </div>
    
      <div class="detente-muscu" id="musculaire">
        <div class="txt">
          <h2>Massage détente musculaire</h2>
          <p>
            Un temps pour souffler et relâcher les tensions accumulées. Par un
            toucher enveloppant et un rythme lent, ce massage invite le corps à se
            détendre en profondeur, facilite la respiration et le relâchement, et
            apaise l'esprit.
          </p>
          <p>
            Une parenthèse de calme, simplement pour se reposer et se reconnecter
            à soi.
          </p>
        </div>
        <img src="/pictures/detente-musculaire.jpg" alt="Massage détente musculaire">
      </div>
    
      <div class="conva" id="convalescence">
        <div class="txt">
          <h2>Massage convalescence®</h2>
          <p>
            Le massage convalescence accompagne pendant et après la maladie, le
            choc, l'épreuve. La convalescence est cette période de transition avant
            le retour à la santé : suite à un burn-out, un stress durable, une
            maladie, un accident, un deuil.
          </p>
          <p>
            La séance s'adapte au corps, à ses cicatrices, ses douleurs et ses
            sensibilités, pour offrir un véritable moment de lâcher-prise, là où
            c'est trop lourd à porter, émotionnellement comme physiquement.
          </p>
        </div>
        <img src="/pictures/convalescence.png" alt="Massage convalescence®">
      </div>
    
      <div class="zone-parcours">
        <div class="parcours-head">
          <p class="eyebrow">Sur mesure</p>
          <h2>Un massage sur une zone en particulier</h2>
          <p>Une douleur localisée, une zone à soulager ? Trois façons de prendre soin de vous.</p>
        </div>

        <div class="timeline">
          <div class="spine" aria-hidden="true">
            <svg viewBox="0 0 2 100" preserveAspectRatio="none">
              <g class="grow"><path d="M1 0 V100" vector-effect="non-scaling-stroke"/></g>
            </svg>
          </div>
        
          <div class="chapter">
            <span class="dot"></span>
            <div class="card">
              <span class="tag">Le dos</span>
              <h3>Massage du dos</h3>
              <p>
                Siège privilégié des tensions du quotidien. Un travail attentif le long
                de la colonne et des épaules, pour dénouer, détendre et redonner de la
                mobilité.
              </p>
            </div>
          </div>
        
          <div class="chapter">
            <span class="dot"></span>
            <div class="card">
              <span class="tag">Les jambes</span>
              <h3>Massage des jambes</h3>
              <p>
                Pour relancer la circulation, soulager la sensation de lourdeur et
                libérer les muscles sollicités. Bienvenu après l'effort ou une longue
                journée debout.
              </p>
            </div>
          </div>
        
          <div class="chapter">
            <span class="dot"></span>
            <div class="card">
              <span class="tag">Sur mesure</span>
              <h3>Massage sur mesure</h3>
              <p>
                Rien n'est figé : la séance dure le temps qui semble juste, sur le corps
                entier ou seulement certaines zones. Nous échangeons d'abord, puis je
                reste à l'écoute de ce que votre corps exprime.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <section class="closing">
      <div class="wrap">
        <span class="mark" aria-hidden="true">“</span>
        <blockquote class="reveal">Détendez vous, et profiter.</blockquote>
        <div class="cta-row reveal">
          <a class="btn btn-primary" href="https://terapiz.com/masseur/le-lavandou/carole-renaud">Réserver un créneau</a>
          <a class="btn btn-ghost" href="/cabinet/tarifs">Voir les tarifs</a>
        </div>
      </div>
    </section>

    <Footer/>
  </body>
</html>