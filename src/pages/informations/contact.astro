---
import Header from "../../components/Header.astro"
import Footer from "../../components/Footer.astro"
import Meta from "../../components/Meta.astro"
// globals.css EN PREMIER : palette, police et reset, dont contact.css
// a besoin. À ne pas retirer même s'il semble déjà chargé ailleurs.
import '../../styles/globals.css'
import '../../styles/contact.css'

const W3F_API_KEY = import.meta.env.W3F_API_KEY;

const adresse = "43 rue des Bugadières, Appart Fitness, 83980 Le Lavandou";

// Lien vers Google Maps : ouvert par le visiteur, sur son initiative.
const lienMaps =
  "https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent(adresse);

const planAcces: string = "/pictures/maps.png";
---

<!DOCTYPE html>
<html lang="fr">
<head>
    <Meta
        title="Me contacter — cabinet de massages au Lavandou"
        description="Contacter le cabinet de massages bien-être du Lavandou : adresse, téléphone et formulaire. Rue des Bugadières, au Lavandou (Var)."
        image="/pictures/maps.png"
    />
    <script src="https://web3forms.com/client/script.js" async defer></script>
    <script>import "../../scripts/form"</script>
</head>
<body class="page-teal">
    <Header/>
    <main>
        <div>
            <h1>Nous contacter</h1>
            <div class="map">
                <div class="informations">
                    <h2>Adresse</h2>
                    <p>{adresse}</p>

                    <h2>Téléphone</h2>
                    <p>+33 6 83 65 65 02</p>
                </div>

                <a class="plan" href={lienMaps} target="_blank" rel="noopener noreferrer">
                    {planAcces ? (
                        <img src={planAcces} alt={`Plan d'accès au cabinet, ${adresse}`} loading="lazy" />
                    ) : (
                        <span class="plan-vide" aria-hidden="true"></span>
                    )}
                    <span class="plan-legende">
                        <strong>Ouvrir dans Google Maps</strong>
                        <span>Itinéraire et horaires — nouvel onglet</span>
                    </span>
                </a>
            </div>
            <div class="formulaire">
                <img class="picture" src="/pictures/carole.jpg" alt="Carole Renaud, praticienne en massages bien-être et shiatsu au Lavandou">
                <h2>Vous souhaitez me contacter ?</h2>
                <form action="https://api.web3forms.com/submit" method="POST" id="form">
                    <input type="hidden" name="access_key" value={W3F_API_KEY}>
                    
                    <div class="surname">
                        <label for="surname">Nom</label>
                        <input type="text" name="surname" id="surname" required>
                    </div>
                    <div class="name">
                        <label for="name">Prénom</label>
                        <input type="text" name="name" id="name" required>
                    </div>
                    <div class="email">
                        <label for="email">Email</label>
                        <input type="email" name="email" id="email" required>
                    </div>
                    <div class="object">
                        <label for="object">Objet</label>
                        <input type="text" name="object" id="object" required>
                    </div>
                    <div class="message">
                        <label for="message">Votre message</label>
                        <textarea name="message" id="message" cols="30" rows="10"></textarea>
                    </div>
                    <div class="h-captcha" data-captcha="true"></div>
                    <div class="button">
                        <input type="submit" value="Envoyé">
                    </div>
                    <!-- RGPD art. 13 : l'information doit être donnée
                         AU MOMENT de la collecte, pas seulement dans les
                         mentions légales. Une ligne suffit, à condition
                         qu'elle renvoie au détail. -->
                    <p class="rgpd">
                        Vos coordonnées servent uniquement à répondre à ce message. Elles ne
                        sont ni cédées ni utilisées à des fins commerciales. Vous pouvez
                        demander leur suppression à tout moment —
                        <a href="/informations/mentions">en savoir plus</a>.
                    </p>
                </form>
                <div id="result"></div>
            </div>
        </div>
    </main>
    <Footer/>
</body>
</html>