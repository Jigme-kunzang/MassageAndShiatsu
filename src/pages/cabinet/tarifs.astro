---
import prestations from '../../../public/prestations.json'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import '../../styles/tarifs.css'
---

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tarifs</title>
</head>
<body>
    <Header/>
    <main>
        <h1>Les tarifs</h1>
        <table>
            <tr>
                <th>Prestions</th>
                <th>Durées</th>
                <th>Tarifs</th>
            </tr>
            <tbody>
                {prestations.map((prestation) => (
                    <tr>
                        <td>{prestation.nom}</td>
                        <td>{prestation.durée} minutes</td>
                        <td>{prestation.tarif} €</td>
                    </tr>
                ))}
            </tbody>
        </table>
    </main>
    <Footer/>
</body>
</html>