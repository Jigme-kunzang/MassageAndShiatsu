---
import prestations from '../../../public/prestations.json'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import '../../styles/tarifs.css'
---

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tarifs</title>
</head>
<body>
    <Header/>
    <main>
        <h1>Les tarifs</h1>
        <table>
            <tr>
                <th>Prestations</th>
                <th>Durées</th>
                <th>Tarifs</th>
            </tr>
            <tbody>
                {prestations.map((prestation) => (
                    <tr>
                        {/* data-label : sur mobile les en-têtes sont masqués,
                            c'est cet attribut qui réaffiche le nom de la
                            colonne à gauche de chaque valeur */}
                        <td data-label="Prestation">{prestation.nom}</td>
                        <td data-label="Durée">{prestation.durée} minutes</td>
                        <td data-label="Tarif">{prestation.tarif} €</td>
                    </tr>
                ))}
            </tbody>
        </table>
    </main>
    <Footer/>
</body>
</html>