---
// `tarifs` : une ligne par durée proposée. Les intitulés ne sont
// écrits qu'à cet endroit (voir public/prestations.json).
import { tarifs } from '../../../public/prestations.json'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import Meta from '../../components/Meta.astro'
// globals.css EN PREMIER : il porte la palette, la police et le reset,
// dont tarifs.css a besoin. L'importer ici plutôt que de compter sur
// un composant garantit l'ordre de chargement.
import '../../styles/globals.css'
import '../../styles/tarifs.css'

const tarifsGroupes = tarifs.reduce((groupes, prestation) => {
    let groupe = groupes.find((item) => item.nom === prestation.nom)
    if (!groupe) {
        groupe = { nom: prestation.nom, offres: [] }
        groupes.push(groupe)
    }
    groupe.offres.push(prestation)
    return groupes
}, [] as { nom: string; offres: typeof tarifs }[])

for (const groupe of tarifsGroupes) {
    groupe.offres.sort((a, b) => a["durée"] - b["durée"])
}
---

<!DOCTYPE html>
<html lang="fr">
<head>
    <Meta
        title="Tarifs des massages — cabinet du Lavandou"
        description="Tarifs et durées de tous les massages : énergétique, détente musculaire, convalescence®, shiatsu, abhyanga, chi nei tsang et séance à domicile."
    />
</head>
<body class="page-teal">
    <Header/>
    <main>
        <h1>Les tarifs</h1>
        <table>
            <!-- la ligne d'en-tête DOIT être dans un <thead> : sans lui le
                 navigateur la range dans le <tbody>, et la règle mobile
                 `main thead { display: none }` de tarifs.css ne s'applique
                 jamais — l'en-tête s'affichait alors comme une fiche de plus -->
            <thead>
                <tr>
                    <th>Prestations</th>
                    <th>Durées</th>
                    <th>Tarifs</th>
                </tr>
            </thead>
            <tbody>
                {tarifsGroupes.map((groupe) => (
                    <tr>
                        {/* data-label : sur mobile les en-têtes sont masqués,
                            c'est cet attribut qui réaffiche le nom de la
                            colonne à gauche de chaque valeur */}
                        <td data-label="Prestation">{groupe.nom}</td>
                        <td data-label="Durées">
                            <div class="tarif-options">
                                {groupe.offres.map((offre) => <div>{offre["durée"]} minutes</div>)}
                            </div>
                        </td>
                        <td data-label="Tarifs">
                            <div class="tarif-options">
                                {groupe.offres.map((offre) => <div>{offre.tarif} €</div>)}
                            </div>
                        </td>
                    </tr>
                ))}
            </tbody>
        </table>
    </main>
    <Footer/>
</body>
</html>