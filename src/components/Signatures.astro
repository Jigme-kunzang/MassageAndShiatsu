---
// Affiche la signature décorative du hero selon le type demandé.
// Une seule signature est rendue par page (choisie dans le Markdown).
interface Props { type: "meridian" | "ripples" | "spiral" }
const { type } = Astro.props;
---
{type === "meridian" && (
  <svg class="meridian" viewBox="0 0 120 640" aria-hidden="true" preserveAspectRatio="xMidYMin slice">
    <path d="M60 0 C 20 90, 100 170, 60 260 C 20 350, 100 430, 60 520 C 30 590, 70 620, 60 640"/>
    <circle cx="52" cy="70" r="6"/>
    <circle cx="82" cy="215" r="6"/>
    <circle cx="40" cy="345" r="6"/>
    <circle cx="86" cy="470" r="6"/>
    <circle cx="55" cy="585" r="6"/>
  </svg>
)}

{type === "ripples" && (
  <svg class="ripples" viewBox="0 0 400 400" aria-hidden="true">
    <circle cx="200" cy="200" r="70"/>
    <circle cx="200" cy="200" r="120"/>
    <circle cx="200" cy="200" r="170"/>
    <circle cx="200" cy="200" r="196"/>
  </svg>
)}

{type === "spiral" && (
  <svg class="spiral" viewBox="0 0 440 440" aria-hidden="true">
    <path d="M 216.0 210.0 L 217.9 211.4 L 219.5 213.6 L 220.5 216.3 L 220.7 219.4 L 220.2 222.8 L 218.7 226.2 L 216.3 229.5 L 212.9 232.4 L 208.8 234.6 L 203.9 236.0 L 198.6 236.4 L 192.9 235.6 L 187.1 233.6 L 181.6 230.4 L 176.5 225.8 L 172.2 220.1 L 168.9 213.4 L 166.9 205.7 L 166.4 197.5 L 167.5 189.0 L 170.3 180.5 L 174.8 172.4 L 181.0 164.9 L 188.7 158.6 L 197.8 153.5 L 208.1 150.2 L 219.1 148.8 L 230.6 149.4 L 242.1 152.3 L 253.2 157.4 L 263.5 164.6 L 272.6 173.9 L 280.0 185.0 L 285.4 197.6 L 288.4 211.3 L 289.0 225.7 L 286.8 240.4 L 281.9 254.7 L 274.2 268.3 L 264.0 280.5 L 251.5 290.9 L 236.9 299.0 L 220.8 304.4 L 203.6 306.9 L 185.9 306.2 L 168.2 302.2 L 151.2 294.9 L 135.5 284.5 L 121.6 271.1 L 110.2 255.1 L 101.8 237.0 L 96.6 217.4 L 95.1 196.7 L 97.3 175.7 L 103.4 155.2 L 113.3 135.7 L 126.8 118.1 L 143.5 102.9 L 163.0 90.8 L 184.7 82.3 L 207.9 77.7 L 232.0 77.5 L 256.1 81.6 L 279.3 90.1 L 301.0 102.9 L 320.3 119.6 L 336.5 139.8 L 349.0 162.9 L 357.2 188.3 L 360.8 215.1 L 359.5 242.4 L 353.2 269.5 L 342.0 295.3 L 326.1 318.9 L 305.9 339.6 L 282.1 356.5 L 255.3 369.1 L 226.2 376.7 L 196.0 378.9 L 165.4 375.7 L 135.6 366.9 L 107.5 352.7 L 82.1 333.5 L 60.3 309.8 L 43.0 282.2 L 30.7 251.6 L 24.1 218.9 L 23.5 185.2 L 29.0 151.6 L 40.5 119.2 L 57.9 89.0 L 80.7 62.2 L 108.2 39.6 L 139.6 22.2 L 174.0 10.6 L 210.3 5.3"/>
    <circle cx="216" cy="210" r="5"/>
  </svg>
)}